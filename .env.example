# ==============================================================================
# ZEMAN Trading & Services — Variáveis de Ambiente de Exemplo (.env.example)
# Copie este ficheiro para .env caso deseje personalizar variáveis no ambiente de produção
# ==============================================================================

# URL base do website quando publicado na Hostinger (ex: https://zemanservices.ao ou https://seusite.com)
VITE_SITE_URL="https://seusite.com"

# Nome da Aplicação
VITE_APP_TITLE="ZEMAN Trading & Services — Hospedagem & Resorts"

# Telefones oficiais de contacto (opcional para sobrescrever valores padrão)
VITE_CONTACT_PHONE_1="+244 923 000 000"
VITE_CONTACT_PHONE_2="+244 912 000 000"
VITE_CONTACT_WHATSAPP="+244 923 000 000"
VITE_CONTACT_EMAIL="reservas@zeman.ao"

# Chave API do Google Gemini (necessária apenas se forem chamados recursos de IA no servidor)
# GEMINI_API_KEY="SUA_CHAVE_AQUI"
